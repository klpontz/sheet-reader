# Apache config for sheeetreader.com on Bluehost.
# The page carries its own Content-Security-Policy in a meta tag. A meta tag
# cannot set frame-ancestors, so this file adds the headers that only a
# server can send.

Options -Indexes
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve only the page. Every other path returns 404.
RewriteCond %{REQUEST_URI} !^/(index\.html)?$
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header set Cache-Control "no-cache"
</IfModule>
